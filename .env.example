# Copy to .env and fill in real values:

# Hugging Face API token
HF_TOKEN=

# 1: load translation model locally instead of using HF API
USE_LOCAL_MODEL=

# Database path (default: data/db/cucciolofinder.db)
DB_PATH=

# Images storage path (default: data/images)
IMAGES_PATH=

# ViT image classifier (default: wesleyacheng/dog-breeds-multiclass-image-classification-with-vit).
# Bumping this value invalidates all `inferred_dog_breeds` rows where method='image' /
# 'image_2nd' on the next enrichment run — the skip check matches on (method, model_name),
# so the new ID won't match existing rows and they get re-classified.
IMAGE_MODEL_ID=

# LLM backend selection (mistral | groq | openrouter) — defaults to mistral.
# Each toggle is independent; pick a different backend per workload.
TRANSLATION_BACKEND=
SEARCH_BACKEND=
EXTRACT_BACKEND=

# Required when any backend is "groq"
GROQ_API_KEY=
# Optional Groq overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=
GROQ_TIMEOUT=

# Required when any backend is "openrouter"
OPENROUTER_API_KEY=
# Optional OpenRouter overrides
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=
OPENROUTER_TIMEOUT=

# Set to 0 to disable opportunistic remote → Mistral fallback when Mistral
# is already loaded for some other workload. Default 1. Applies to both
# Groq and OpenRouter.
REMOTE_FALLBACK_TO_MISTRAL=

# Deprecated alias for REMOTE_FALLBACK_TO_MISTRAL — read for backwards
# compatibility, will be removed in a future release.
GROQ_FALLBACK_TO_MISTRAL=
