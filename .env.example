# Copy to .env and fill in real values:

# Hugging Face API token
HF_TOKEN=

# 1: load translation model locally instead of using HF API
USE_LOCAL_MODEL=

# Database path (default: data/db/cucciolofinder.db)
DB_PATH=

# Images storage path (default: data/images)
IMAGES_PATH=

# LLM backend selection (mistral | groq) — defaults to mistral
TRANSLATION_BACKEND=
SEARCH_BACKEND=

# Required when either backend is "groq"
GROQ_API_KEY=
# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=
GROQ_TIMEOUT=

# Set to 0 to disable opportunistic Groq → Mistral fallback when Mistral is
# already loaded for the other workload. Default 1.
GROQ_FALLBACK_TO_MISTRAL=
