VITE_API_BASE_URL=http://localhost:8000
VITE_IMAGE_PREFIX=

# Contact form (see tests/docs/DEPLOYMENT.md). Both keys are public-safe.
VITE_WEB3FORMS_KEY=8271658e-877e-412c-b19a-f0b9da8d01f7
# Web3Forms' shared free-tier hCaptcha sitekey. The hCaptcha test sitekey
# (10000000-…) can't be used because Web3Forms validates tokens with their
# own secret, which only matches this shared sitekey.
VITE_HCAPTCHA_SITE_KEY=50b2fe65-b00b-4b9e-ad62-3ba471098be2
# 'normal' (visible checkbox) or 'invisible'. Localhost can't validate
# invisible mode, so keep this 'normal' in dev regardless.
VITE_HCAPTCHA_MODE=normal
